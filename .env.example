# Devrunner ayarları. Bu dosya scripts/config.py'den üretilir: python -m scripts.config
# Kopyalayın: cp .env.example .env   (Windows: copy .env.example .env)
# Değerleri uygulama içindeki Ayarlar sayfasından da girebilirsiniz.
# .env dosyası depoya GİRMEZ (.gitignore).

# ---------------------------------------------------------------------------
# Genel
# ---------------------------------------------------------------------------
# Bu bir kimlik doğrulama değildir; ekip içi güvene dayalı bir araçtır.
# Adınız: Notlarda, sohbette ve değişiklik geçmişinde görünür.
USER_NAME=
# Kullanıcı kimliği: İlk açılışta üretilir. Değiştirmeyin: geçmiş kayıtlar bu kimliğe bağlıdır.
USER_ID=

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Ekibin ortak verisi (notlar, Bilge talepleri, freeze, değişiklik geçmişi) burada tutulur.
# Sunucu: Boşsa notlar, talepler, freeze ve sohbet kapalıdır.
DB_HOST=
DB_PORT=5432
DB=
DB_USER=
DB_PW=
DB_REFRESH_SEC=60

# ---------------------------------------------------------------------------
# Azure DevOps
# ---------------------------------------------------------------------------
# Repolar ve CI/CD pipeline'ları kişinin kendi PAT'i ile okunur.
DEVOPS_URL=https://devops.halkbank.com.tr/DefaultCollection
DEVOPS_PROJECT=Halkbank
# Personal Access Token: Gereken yetkiler: Code (Read), Build (Read), Release (Read). Boşsa örnek veri gösterilir.
DEVOPS_PAT=
DEVOPS_REPO_PREFIX=DDDB.Iz.Anm.
PIPELINE_CI_SUFFIX=_Container-CI
PIPELINE_CD_SUFFIX=_Container-CD
# API sürümü: Şirket içi sunucu sürümüne göre değişebilir.
DEVOPS_API_VERSION=6.0
DEVOPS_REFRESH_SEC=120
DEVOPS_USE_PROXY=0
# Sertifikayı doğrula: Windows sertifika deposu kullanılır. Yalnızca zorunluysa kapatın.
DEVOPS_VERIFY_TLS=1

# ---------------------------------------------------------------------------
# Uygulama adresleri
# ---------------------------------------------------------------------------
# {app} yerine uygulama adı (repo adından önek atılmış, küçük harf) gelir. Kurala uymayan uygulamalar için adres, Uygulamalar sayfasında uygulama bazında ezilebilir.
URL_DEV=https://{app}.dk8s.gentest.hqtest.local/
URL_TEST=https://{app}.tk8s.gentest.hqtest.local/
URL_PROD=https://{app}.pk8s.gen.halkbank.local/

# ---------------------------------------------------------------------------
# Erişilebilirlik
# ---------------------------------------------------------------------------
# Uygulamaların Dev/Test/Prod adreslerine düzenli HTTP isteği atılır.
HEALTH_ENABLED=1
HEALTH_INTERVAL_SEC=60
HEALTH_TIMEOUT_SEC=10
HEALTH_SLOW_MS=3000
HEALTH_USE_PROXY=0
HEALTH_NOTIFY=1

# ---------------------------------------------------------------------------
# Kubernetes
# ---------------------------------------------------------------------------
# Kubeconfig uygulamaya gömülüdür; yalnızca cluster adresi ve servis hesabı token'ı girilir. Hiçbir ortam girilmemişse örnek veri gösterilir.
K8S_NAMESPACE=verianalitigi
# Dev cluster adresi: ip, ip:port veya https://… kabul edilir. Boşsa Dev kapalı.
K8S_DEV_SERVER=
K8S_DEV_TOKEN=
K8S_TEST_SERVER=
K8S_TEST_TOKEN=
K8S_PROD_SERVER=
K8S_PROD_TOKEN=
K8S_LOG_LINES=300

# ---------------------------------------------------------------------------
# Terminal
# ---------------------------------------------------------------------------
# Varsayılan kabuk: auto, powershell, pwsh, cmd, bash, zsh veya sh
TERMINAL_SHELL=auto

# ---------------------------------------------------------------------------
# Sohbet
# ---------------------------------------------------------------------------
# Eşler birbirini ortak PostgreSQL üzerinden bulur; mesajlar doğrudan ve uçtan uca şifreli gider.
CHAT_ENABLED=1
# Dinleme portu: Doluysa boş bir port seçilir.
CHAT_PORT=47800
# Yayınlanacak IP: Boşsa veritabanı sunucusuna giden yoldaki yerel adres kullanılır.
CHAT_ADVERTISE_IP=

# ---------------------------------------------------------------------------
# Freeze
# ---------------------------------------------------------------------------
FREEZE_WARN_DAYS=3
